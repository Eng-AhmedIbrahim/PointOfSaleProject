@using MudBlazor
@using Radzen
@using Radzen.Blazor
@using POS.Contract.Dtos.AccountDtos
@using BlazorBase.ERPFrontServices.AccountServices
@inject IAccountService AccountService
@inject ISnackbar Snackbar

<style>
    .change-dialog {
        border-radius: 16px !important;
        overflow: hidden;
    }
    .change-header {
        background: linear-gradient(135deg, #10b981 0%, #047857 100%);
        color: white;
        padding: 1.25rem 1.75rem;
        margin: -16px -24px 16px -24px;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.25);
    }
    .change-header-icon {
        background: rgba(255, 255, 255, 0.2);
        padding: 10px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .field-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.75rem;
        transition: all 0.2s;
        margin-bottom: 1rem;
    }
    .field-card:focus-within {
        border-color: #10b981;
        background: white;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .field-label {
        font-weight: 900;
        color: #334155;
        font-size: 0.95rem;
        margin-bottom: 4px;
        display: block;
    }
</style>

<MudDialog Class="change-dialog" dir="@(IsArabic ? "rtl" : "ltr")">
    <TitleContent>
        <div class="change-header">
            <div class="change-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.VpnKey" Size="Size.Large" Color="Color.Inherit" />
            </div>
            <div>
                <MudText Typo="Typo.h5" Style="font-weight: 900;">@(IsArabic ? "تغيير كلمة المرور الخاصة بك" : "Change Your Password")</MudText>
                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.85); font-weight: 700;">
                    @(IsArabic ? "يرجى إدخال كلمة المرور الحالية ثم الجديدة" : "Enter your current password and new password")
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="field-card">
            <label class="field-label">@(IsArabic ? "كلمة المرور الحالية" : "Current Password")</label>
            <MudTextField @bind-Value="_currentPassword"
                          InputType="@(_showCurrentPassword ? InputType.Text : InputType.Password)"
                          Variant="MudBlazor.Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showCurrentPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                          OnAdornmentClick="() => _showCurrentPassword = !_showCurrentPassword"
                          AdornmentAriaLabel="Toggle Password Visibility"
                          Placeholder="@(IsArabic ? "أدخل كلمة المرور الحالية..." : "Enter current password...")"
                          Style="font-weight: 800; font-size: 1.1rem;" />
        </div>

        <div class="field-card">
            <label class="field-label">@(IsArabic ? "كلمة المرور الجديدة" : "New Password")</label>
            <MudTextField @bind-Value="_newPassword"
                          InputType="@(_showNewPassword ? InputType.Text : InputType.Password)"
                          Variant="MudBlazor.Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showNewPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                          OnAdornmentClick="() => _showNewPassword = !_showNewPassword"
                          AdornmentAriaLabel="Toggle Password Visibility"
                          Placeholder="@(IsArabic ? "أدخل كلمة المرور الجديدة..." : "Enter new password...")"
                          Style="font-weight: 800; font-size: 1.1rem;" />
        </div>

        <div class="field-card">
            <label class="field-label">@(IsArabic ? "تأكيد كلمة المرور الجديدة" : "Confirm New Password")</label>
            <MudTextField @bind-Value="_confirmPassword"
                          InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                          Variant="MudBlazor.Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                          OnAdornmentClick="() => _showConfirmPassword = !_showConfirmPassword"
                          AdornmentAriaLabel="Toggle Password Visibility"
                          Placeholder="@(IsArabic ? "أعد إدخال كلمة المرور للتأكيد..." : "Re-enter new password...")"
                          Style="font-weight: 800; font-size: 1.1rem;" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="MudBlazor.Variant.Text" Style="font-weight: 900;">
            @(IsArabic ? "تراجع" : "Discard")
        </MudButton>
        <MudButton OnClick="Submit" Variant="MudBlazor.Variant.Filled"
                   Color="Color.Success" Style="font-weight: 900; padding: 0.6rem 2rem; border-radius: 12px;" 
                   Disabled="@IsSaving">
            @if (IsSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Save" Class="me-2" />
                <MudText>@(IsArabic ? "حفظ التغييرات" : "Update Password")</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string UserName { get; set; } = "";
    [Parameter] public bool IsArabic { get; set; } = true;

    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _showCurrentPassword = false;
    private bool _showNewPassword = false;
    private bool _showConfirmPassword = false;
    private bool IsSaving = false;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            Snackbar.Add(IsArabic ? "يرجى إدخال كلمة المرور الحالية" : "Please enter current password", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            Snackbar.Add(IsArabic ? "يرجى إدخال كلمة المرور الجديدة" : "Please enter new password", Severity.Warning);
            return;
        }

        if (_newPassword.Length < 3)
        {
            Snackbar.Add(IsArabic ? "يجب ألا تقل كلمة المرور عن 3 أحرف" : "Password must be at least 3 characters", Severity.Warning);
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add(IsArabic ? "كلمة المرور وتأكيدها غير متطابقين" : "Passwords do not match", Severity.Warning);
            return;
        }

        IsSaving = true;
        try
        {
            var dto = new ChangeOwnPasswordDto
            {
                UserName = UserName,
                CurrentPassword = _currentPassword,
                NewPassword = _newPassword,
                ConfirmPassword = _confirmPassword
            };

            var (success, errorMessage) = await AccountService.ChangeOwnPassword(dto);
            if (success)
            {
                Snackbar.Add(IsArabic ? "تم تحديث كلمة المرور الخاصة بك بنجاح" : "Your password was changed successfully", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(errorMessage ?? (IsArabic ? "فشل تغيير كلمة المرور، تأكد من صحة كلمة المرور الحالية" : "Failed to change password, verify current password"), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }
}
