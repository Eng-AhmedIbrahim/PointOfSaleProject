@using BlazorBase
@using POS.Contract.Dtos.CompanyDtos
@using BlazorBase.ERPFrontServices.BranchServices
@using BlazorBase.ERPFrontServices.DeliveryServices
@inject CommonProperties _commonProperties
@inject LocalizationService Localizer
@inject MudBlazor.ISnackbar _snackbar
@inject IBranchService _branchService
@inject IDeliveryServices _deliveryServices

<MudDialog Class="@(_commonProperties.IsRtl ? "rtl-dialog" : "")">
    <DialogContent>
        <div class="customer-info-wrapper" dir="@(_commonProperties.IsRtl ? "rtl" : "ltr")">
            
            <!-- Modern Gradient Header -->
            <div class="dialog-hero-header">
                <div class="hero-content">
                    <div class="hero-icon-box">
                        <MudIcon Icon="@Icons.Material.Filled.PersonPinCircle" Size="Size.Large" Class="hero-icon" />
                    </div>
                    <div class="hero-text">
                        <MudText Typo="Typo.h6" Class="hero-title">بيانات العميل وعنوان التوصيل</MudText>
                        <MudText Typo="Typo.caption" Class="hero-subtitle">تفاصيل العنوان وتوجيه الطلب للفرع المنفذ</MudText>
                    </div>
                </div>
                @if (_isBranchChanged)
                {
                    <div class="transfer-badge animate-pulse">
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Class="me-1" />
                        <span>تم تحويل الفرع</span>
                    </div>
                }
            </div>

            <div class="dialog-body-content">
                
                <!-- Card 1: البيانات الأساسية -->
                <div class="modern-card">
                    <div class="card-header-bar">
                        <div class="card-header-title">
                            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Small" Class="card-icon" />
                            <span>البيانات الأساسية للعميل</span>
                        </div>
                    </div>
                    <div class="card-inner-body">
                        <div class="data-grid-2col">
                            <div class="data-item">
                                <span class="data-label">اسم العميل</span>
                                <span class="data-value customer-name">
                                    @(!string.IsNullOrWhiteSpace(_commonProperties.CustomerDetails?.CustomerName) ? _commonProperties.CustomerDetails.CustomerName : "غير محدد")
                                </span>
                            </div>
                            <div class="data-item">
                                <span class="data-label">الهاتف الأساسي</span>
                                <span class="data-value phone-highlight">
                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="inline-icon me-1" />
                                    @(!string.IsNullOrWhiteSpace(_commonProperties.CustomerDetails?.FirstPhoneNumber) ? _commonProperties.CustomerDetails.FirstPhoneNumber : "غير مسجل")
                                </span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_commonProperties.CustomerDetails?.SecondPhoneNumber))
                        {
                            <div class="data-item mt-2">
                                <span class="data-label">الهاتف الإضافي</span>
                                <span class="data-value phone-secondary">
                                    <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" Size="Size.Small" Class="inline-icon me-1" />
                                    @_commonProperties.CustomerDetails.SecondPhoneNumber
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Card 2: تفاصيل العنوان -->
                <div class="modern-card mt-3">
                    <div class="card-header-bar">
                        <div class="card-header-title">
                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Class="card-icon location-icon" />
                            <span>تفاصيل عنوان التوصيل</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_commonProperties.CustomerDetails?.ZoneName))
                        {
                            <span class="zone-pill">
                                <MudIcon Icon="@Icons.Material.Filled.Explore" Size="Size.Small" Class="me-1" />
                                @_commonProperties.CustomerDetails.ZoneName
                            </span>
                        }
                    </div>
                    <div class="card-inner-body">
                        <!-- Full Address -->
                        <div class="data-item full-span">
                            <span class="data-label">العنوان بالتفصيل</span>
                            <span class="data-value address-text">
                                @(!string.IsNullOrWhiteSpace(_commonProperties.CustomerDetails?.ClientAddress) ? _commonProperties.CustomerDetails.ClientAddress : "لم يتم تحديد عنوان تفصيلي")
                            </span>
                        </div>

                        <!-- Building, Floor, Flat Mini-Cards -->
                        <div class="address-units-grid mt-2">
                            <div class="unit-box">
                                <span class="unit-label">رقم العمارة / المنزل</span>
                                <span class="unit-value">@(!string.IsNullOrWhiteSpace(_commonProperties.CustomerDetails?.HomeNumber) ? _commonProperties.CustomerDetails.HomeNumber : "-")</span>
                            </div>
                            <div class="unit-box">
                                <span class="unit-label">رقم الدور</span>
                                <span class="unit-value">@(!string.IsNullOrWhiteSpace(_commonProperties.CustomerDetails?.FloorNumber) ? _commonProperties.CustomerDetails.FloorNumber : "-")</span>
                            </div>
                            <div class="unit-box">
                                <span class="unit-label">رقم الشقة</span>
                                <span class="unit-value">@(!string.IsNullOrWhiteSpace(_commonProperties.CustomerDetails?.FlatNumber) ? _commonProperties.CustomerDetails.FlatNumber : "-")</span>
                            </div>
                        </div>

                        <!-- Delivery Fee if available -->
                        @if ((_commonProperties.CustomerDetails?.ZoneFees ?? 0) > 0)
                        {
                            <div class="delivery-fee-badge mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.DeliveryDining" Size="Size.Small" Class="me-1" />
                                <span>رسوم التوصيل المقررة للمنطقة: <strong>@_commonProperties.CustomerDetails!.ZoneFees.ToString("N2") ج.م</strong></span>
                            </div>
                        }

                        <!-- Address Note -->
                        @if (!string.IsNullOrEmpty(_commonProperties.CustomerDetails?.AddressNote))
                        {
                            <div class="note-callout mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="note-icon" />
                                <div class="note-body">
                                    <span class="note-label">ملاحظات العنوان:</span>
                                    <span class="note-content">@_commonProperties.CustomerDetails.AddressNote</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Card 3: اختيار وتحويل الفرع المنفذ للطلب -->
                <div class="modern-card mt-3 branch-card">
                    <div class="card-header-bar branch-header">
                        <div class="card-header-title">
                            <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" Class="card-icon branch-icon" />
                            <span>توجيه الأوردر إلى الفرع</span>
                        </div>
                        @if (_isBranchChanged)
                        {
                            <button type="button" class="reset-branch-btn" @onclick="ResetToOriginalBranch" title="استعادة فرع العنوان الأصلي">
                                <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" Class="me-1" />
                                <span>إعادة للفرع الأصلي</span>
                            </button>
                        }
                    </div>
                    <div class="card-inner-body">
                        <div class="branch-selector-wrapper">
                            <label class="data-label mb-1 d-block">
                                اختر الفرع المطلوب تنفيذ الطلب من خلاله:
                            </label>
                            
                            @if (_isLoading)
                            {
                                <div class="d-flex align-center justify-center py-2">
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                    <span class="ms-2">جاري تحميل الفروع...</span>
                                </div>
                            }
                            else if (_branches.Any())
                            {
                                <MudSelect T="int" 
                                           Value="@_selectedBranchId" 
                                           ValueChanged="@OnBranchChanged"
                                           Variant="Variant.Outlined" 
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           AnchorOrigin="Origin.BottomCenter"
                                           Class="custom-branch-select">
                                    @foreach (var branch in _branches)
                                    {
                                        <MudSelectItem Value="@branch.Id">
                                            <div class="d-flex align-center justify-space-between w-100">
                                                <div class="d-flex align-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" Class="me-2 text-primary" />
                                                    <span class="fw-bold">@branch.Name</span>
                                                </div>
                                                @if (branch.Id == _originalBranchId)
                                                {
                                                    <span class="original-tag">فرع العنوان</span>
                                                }
                                            </div>
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Error">لم يتم العثور على فروع نشطة.</MudText>
                            }

                            <!-- Routing Status Banner -->
                            @if (_isBranchChanged)
                            {
                                <div class="routing-alert mt-2">
                                    <div class="routing-alert-header">
                                        <MudIcon Icon="@Icons.Material.Filled.AltRoute" Size="Size.Small" Class="me-1 text-warning" />
                                        <span>تنبيه: تم تغيير فرع التوصيل لهذا الطلب</span>
                                    </div>
                                    <div class="routing-alert-details">
                                        <span class="origin-tag">الفرع التابع للعنوان: <strong>@(!string.IsNullOrEmpty(_originalBranchName) ? _originalBranchName : "-")</strong></span>
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mx-1 text-muted" />
                                        <span class="target-tag">الفرع الموجه إليه الطلب حالياً: <strong>@_selectedBranchName</strong></span>
                                    </div>
                                    <small class="routing-hint mt-1 d-block text-muted">
                                        * ستبقى جميع بيانات العميل والعنوان كما هي، وسيتم توجيه الطباعة والإرسال إلى الفرع المختار.
                                    </small>
                                </div>
                            }
                            else
                            {
                                <div class="branch-confirmed-box mt-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="text-success me-1" />
                                    <span>الفرع المعتمد للتنفيذ: <strong>@(!string.IsNullOrEmpty(_selectedBranchName) ? _selectedBranchName : "-")</strong></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- Dialog Actions Footer -->
            <div class="dialog-footer-actions">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.CheckCircleOutline"
                           OnClick="Close" 
                           FullWidth="true" 
                           Class="confirm-btn-styled">
                    تأكيد وإغلاق
                </MudButton>
            </div>

        </div>
    </DialogContent>
</MudDialog>

