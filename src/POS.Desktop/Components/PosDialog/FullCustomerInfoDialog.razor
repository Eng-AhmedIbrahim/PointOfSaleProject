@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private List<BranchToReturnDto> _branches = new();
    private int _selectedBranchId;
    private int _originalBranchId;
    private string? _originalBranchName;
    private bool _isLoading = true;

    private string? _selectedBranchName => _branches.FirstOrDefault(b => b.Id == _selectedBranchId)?.Name;
    private bool _isBranchChanged => _originalBranchId > 0 && _selectedBranchId != _originalBranchId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            // 1. Fetch available branches
            var branchesResult = await _branchService.GetBranches();
            _branches = branchesResult?
                .Where(b => b.Active && !b.Suspend)
                .OrderBy(b => b.Name)
                .ToList() ?? new();

            // 2. Resolve initial branch from CustomerDetails
            int initialBranchId = 0;
            string? initialBranchName = null;

            if (_commonProperties.CustomerDetails?.BranchId > 0)
            {
                initialBranchId = _commonProperties.CustomerDetails.BranchId;
                initialBranchName = _commonProperties.CustomerDetails.BranchName;
            }

            // Fallback: Check Zone's BranchId if CustomerDetails.BranchId was not set
            if (initialBranchId <= 0 && (_commonProperties.CustomerDetails?.ZoneID ?? 0) > 0)
            {
                try
                {
                    var zones = await _deliveryServices.GetAllDeliveryZonesAsync();
                    var matchedZone = zones?.FirstOrDefault(z => z.Id == _commonProperties.CustomerDetails!.ZoneID);
                    if (matchedZone != null && matchedZone.BranchId > 0)
                    {
                        initialBranchId = matchedZone.BranchId;
                    }
                }
                catch { }
            }

            // Fallback: Match by name if ID was missing
            if (initialBranchId <= 0 && !string.IsNullOrWhiteSpace(_commonProperties.CustomerDetails?.BranchName))
            {
                var matchedByName = _branches.FirstOrDefault(b => 
                    string.Equals(b.Name, _commonProperties.CustomerDetails.BranchName, StringComparison.OrdinalIgnoreCase));
                if (matchedByName != null)
                {
                    initialBranchId = matchedByName.Id;
                }
            }

            // Fallback: Current workstation BranchDetails
            if (initialBranchId <= 0 && (_commonProperties.BranchDetails?.Id ?? 0) > 0)
            {
                initialBranchId = _commonProperties.BranchDetails!.Id;
            }

            // Fallback: First available branch
            if (initialBranchId <= 0)
            {
                initialBranchId = _branches.FirstOrDefault()?.Id ?? 0;
            }

            _selectedBranchId = initialBranchId;
            _originalBranchId = initialBranchId;

            // Resolve original branch name
            var origBranchObj = _branches.FirstOrDefault(b => b.Id == _originalBranchId);
            _originalBranchName = origBranchObj?.Name ?? initialBranchName ?? _commonProperties.CustomerDetails?.BranchName;

            // Sync CustomerDetails with current branch immediately so it displays correctly
            ApplyBranchSelection(_selectedBranchId, notify: false);
        }
        catch (Exception ex)
        {
            _snackbar.Add($"حدث خطأ أثناء تحميل الفروع: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnBranchChanged(int newBranchId)
    {
        if (newBranchId <= 0 || newBranchId == _selectedBranchId) return;

        _selectedBranchId = newBranchId;
        ApplyBranchSelection(newBranchId, notify: true);
    }

    private void ResetToOriginalBranch()
    {
        if (_originalBranchId > 0 && _originalBranchId != _selectedBranchId)
        {
            _selectedBranchId = _originalBranchId;
            ApplyBranchSelection(_originalBranchId, notify: true);
        }
    }

    private void ApplyBranchSelection(int branchId, bool notify)
    {
        var targetBranch = _branches.FirstOrDefault(b => b.Id == branchId);
        if (targetBranch == null) return;

        // 1. Update CustomerDetails
        if (_commonProperties.CustomerDetails != null)
        {
            _commonProperties.CustomerDetails.BranchId = targetBranch.Id;
            _commonProperties.CustomerDetails.BranchName = targetBranch.Name;
            _commonProperties.CustomerDetails.BranchApiUrl = targetBranch.ApiUrl;
        }

        // 2. Update BranchDetails
        _commonProperties.BranchDetails = targetBranch;

        // 3. Update OrderDto if initialized
        if (_commonProperties.OrderDto != null)
        {
            _commonProperties.OrderDto.BranchId = targetBranch.Id;
            _commonProperties.OrderDto.BranchName = targetBranch.Name;
            _commonProperties.OrderDto.DeliveryBranchUrl = targetBranch.ApiUrl;
        }

        if (notify)
        {
            _snackbar.Add($"تم تحويل الأوردر إلى فرع: {targetBranch.Name}", Severity.Success);
            StateHasChanged();
        }
    }

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}
